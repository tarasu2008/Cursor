<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/keyboard_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/candidate_height"
        android:background="@color/candidate_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">

        <TextView
            android:id="@+id/polite"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginRight="4dp"
            android:background="@drawable/chip_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="@string/polite_key"
            android:textColor="@color/chip_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/pro"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginRight="4dp"
            android:background="@drawable/chip_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="@string/pro_key"
            android:textColor="@color/chip_text"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chips"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/clip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/chip_bg"
            android:clickable="true"
            android:contentDescription="@string/clip_key"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="@string/clip_key"
            android:textColor="@color/chip_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/globe"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/chip_bg"
            android:clickable="true"
            android:contentDescription="@string/switch_key"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="@string/switch_key"
            android:textColor="@color/chip_text"
            android:textSize="13sp" />
    </LinearLayout>

    <com.politetype.ime.ime.PoliteKeyboardView
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/keyboard_bg"
        android:keyBackground="@drawable/key_bg"
        android:keyPreviewHeight="64dp"
        android:keyPreviewLayout="@layout/key_preview"
        android:keyPreviewOffset="8dp"
        android:keyTextColor="@color/key_text"
        android:keyTextSize="@dimen/key_text_size"
        android:labelTextSize="@dimen/key_label_size" />
</LinearLayout>
