<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/keyboard_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/candidate_height"
        android:background="@color/candidate_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/globe"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="@drawable/bar_button"
            android:contentDescription="@string/switch_key"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_globe" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chips"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <ImageView
            android:id="@+id/clip"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="@drawable/bar_button"
            android:contentDescription="@string/clip_key"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_clipboard" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <com.politetype.ime.ime.PoliteKeyboardView
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/keyboard_bg" />
</LinearLayout>
