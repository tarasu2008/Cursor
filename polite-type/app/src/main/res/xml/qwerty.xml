<?xml version="1.0" encoding="utf-8"?>
<!--
  Letter layout matches the phone keyboards people already know:
  suggestions on top, QWERTY underneath, numbers by holding the top row.
  Row widths follow the Apache-2.0 amirisback/keyboard proportions.
-->
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:horizontalGap="0px"
    android:keyHeight="@dimen/key_height"
    android:keyWidth="10%p"
    android:verticalGap="0px">
    <Row>
        <Key android:keyEdgeFlags="left" android:keyLabel="q" android:popupCharacters="1" />
        <Key android:keyLabel="w" android:popupCharacters="2" />
        <Key android:keyLabel="e" android:popupCharacters="3éèêëēę" />
        <Key android:keyLabel="r" android:popupCharacters="4řŕ" />
        <Key android:keyLabel="t" android:popupCharacters="5ťþ" />
        <Key android:keyLabel="y" android:popupCharacters="6ýÿ" />
        <Key android:keyLabel="u" android:popupCharacters="7úùûüū" />
        <Key android:keyLabel="i" android:popupCharacters="8íìîïī" />
        <Key android:keyLabel="o" android:popupCharacters="9óòôöõō" />
        <Key android:keyEdgeFlags="right" android:keyLabel="p" android:popupCharacters="0" />
    </Row>
    <Row>
        <Key
            android:horizontalGap="5%p"
            android:keyEdgeFlags="left"
            android:keyLabel="a"
            android:popupCharacters="áàâãäåæ" />
        <Key android:keyLabel="s" android:popupCharacters="ßśš" />
        <Key android:keyLabel="d" android:popupCharacters="đď" />
        <Key android:keyLabel="f" />
        <Key android:keyLabel="g" />
        <Key android:keyLabel="h" />
        <Key android:keyLabel="j" />
        <Key android:keyLabel="k" />
        <Key
            android:keyEdgeFlags="right"
            android:keyLabel="l"
            android:popupCharacters="ł" />
    </Row>
    <Row>
        <Key
            android:codes="-1"
            android:isModifier="true"
            android:isSticky="true"
            android:keyEdgeFlags="left"
            android:keyLabel="Aa"
            android:keyWidth="15%p" />
        <Key android:keyLabel="z" android:popupCharacters="źžż" />
        <Key android:keyLabel="x" />
        <Key android:keyLabel="c" android:popupCharacters="çćč" />
        <Key android:keyLabel="v" />
        <Key android:keyLabel="b" />
        <Key android:keyLabel="n" android:popupCharacters="ñń" />
        <Key android:keyLabel="m" />
        <Key
            android:codes="-5"
            android:isRepeatable="true"
            android:keyEdgeFlags="right"
            android:keyLabel="Del"
            android:keyWidth="15%p" />
    </Row>
    <Row>
        <Key
            android:codes="-2"
            android:keyEdgeFlags="left"
            android:keyLabel="\?123"
            android:keyWidth="15%p" />
        <Key
            android:keyLabel=","
            android:keyWidth="10%p"
            android:popupCharacters="\'&quot;" />
        <Key
            android:codes="-6"
            android:keyLabel="☺"
            android:keyWidth="10%p" />
        <Key
            android:codes="32"
            android:isRepeatable="true"
            android:keyLabel="English"
            android:keyWidth="40%p" />
        <Key
            android:keyLabel="."
            android:keyWidth="10%p"
            android:popupCharacters="…?!;:" />
        <Key
            android:codes="-4"
            android:keyEdgeFlags="right"
            android:keyLabel="↵"
            android:keyWidth="15%p" />
    </Row>
</Keyboard>
