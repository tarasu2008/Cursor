<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 draws apps edge to edge. That change crashes some keyboard windows. -->
    <style name="Theme.PoliteType" parent="@android:style/Theme.DeviceDefault.Light">
        <item name="android:statusBarColor">#1A73E8</item>
        <item name="android:navigationBarColor">#D5D8DE</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
