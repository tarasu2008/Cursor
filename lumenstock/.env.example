# ==============================================================================
# Lumenstock Production Environment Variables
# Copy to .env.local for local testing, or paste into Vercel / Railway Settings.
# ==============================================================================

# 1. Public site URL (your custom domain in production)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Optional Google Search Console HTML tag verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 2. Optional Cloudflare R2 / S3 CDN URL for the 2,260 files in public/samples/
# Leave blank to serve /samples/* from the Next.js server directly.
# Example: https://cdn.yourdomain.com
NEXT_PUBLIC_ASSET_CDN_URL=

# 3. PostgreSQL Database (Neon, Supabase, or Railway)
# When unset locally, Lumenstock falls back to .data/users.json.
DATABASE_URL=postgresql://user:password@host/lumenstock?sslmode=require

# 4. Auth & Session Security (generate with: openssl rand -base64 32)
LUMENSTOCK_SESSION_SECRET=replace-with-random-32-byte-secret
LUMENSTOCK_ADMIN_EMAIL=tarasu2008@gmail.com
LUMENSTOCK_ADMIN_PASSWORD=replace-with-strong-admin-password

# 5. Payment Gateway — choose EITHER Stripe OR Razorpay (or set PAYMENT_PROVIDER)
# PAYMENT_PROVIDER=stripe | razorpay
PAYMENT_PROVIDER=

# Option A: Stripe Checkout (global cards, one-time payments, no auto-renew)
# Webhook URL to register in Stripe Dashboard:
#   https://yourdomain.com/api/billing/webhook/stripe
# Event to subscribe: checkout.session.completed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Option B: Razorpay Payment Links (India UPI + Indian & international cards)
# Webhook URL to register in Razorpay Dashboard:
#   https://yourdomain.com/api/billing/webhook/razorpay
# Events to subscribe: payment_link.paid, payment.captured
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_INR_RATE=85

# 6. Transactional Emails via Resend (verification, password reset, receipts, renewals)
# Create API key & verify your domain at https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Lumenstock <noreply@yourdomain.com>

# 7. Daily Cron Secret for non-auto-renewing plan expiry reminders
# Generate with: openssl rand -hex 24
CRON_SECRET=
